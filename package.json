{
  "name": "yingjie-yang-homepage",
  "private": true,
  "description": "JavaScript build tools for Yingjie Yang's personal website",
  "license": "MIT",
  "dependencies": {
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "@expressive-code/plugin-collapsible-sections": "0.44.2",
    "@expressive-code/plugin-line-numbers": "0.44.2",
    "cheerio": "1.2.0",
    "expressive-code": "0.44.2",
    "hast-util-to-html": "9.0.5",
    "onchange": "^7.1.0",
    "shiki": "4.5.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "test:theme": "node --test scripts/theme.test.cjs",
    "test:code-blocks": "node --test scripts/render-code-blocks.test.mjs",
    "test:analytics": "node --test scripts/site-analytics.test.cjs",
    "build:js": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/src/navigation.js assets/js/src/theme.js assets/js/src/profile-menu.js -c -m --comments \"/^!/\" -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/src/*.js\" -- npm run build:js"
  }
}
