source 'https://rubygems.org'

# Match GitHub Pages' Jekyll and plugin versions.
gem 'github-pages'

# Local preview server and the existing compatible connection-pool version.
gem 'webrick', '~> 1.8'
gem 'connection_pool', '2.5.0'

# Windows does not include the timezone database used by Jekyll.
gem 'tzinfo-data', platforms: :windows
